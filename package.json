{
   "name": "asm_project_generator",
   "version": "2.3.3",
   "versionDate": "2026-07-30",
   "description": "ASM Project Generator Electron wrapper",
   "main": "main.js",
   "scripts": {
      "start": "electron .",
      "dist:installer": "electron-builder --win nsis --x64",
      "test": "echo \"Error: no test specified\" && exit 1"
   },
   "keywords": [],
   "author": "Новожилов Артем",
   "license": "ISC",
   "type": "commonjs",
   "repository": {
      "type": "git",
      "url": "https://github.com/revi96or/ASM-Project-Generator.git"
   },
   "build": {
      "appId": "ru.asm.projectgenerator",
      "productName": "ASM Project Generator",
      "asar": true,
      "icon": "assets\\asm-icon.ico",
      "publish": [
         {
           "provider": "github",
           "owner": "revi96or",
           "repo": "ASM-Project-Generator"
         }
      ],
      "files": [
         "**/*",
         "!dist/**",
         "!release-backups/**",
         "!templates/**",
         "!.git/**",
         "!*.log",
         "!*.txt"
      ],
      "extraResources": [
         {
            "from": "templates",
            "to": "templates"
         }
      ],
      "win": {
         "icon": "assets\\asm-icon.ico",
         "target": [
            "nsis"
         ]
      },
      "nsis": {
        "artifactName": "ASM_Project_Generator-${version}-setup.exe",
        "oneClick": false,
        "allowToChangeInstallationDirectory": true
      }
   },
   "dependencies": {
     "electron-updater": "^6.5.0"
   },
   "devDependencies": {
     "electron": "^43.2.0",
     "electron-builder": "^26.15.3"
   }
}
