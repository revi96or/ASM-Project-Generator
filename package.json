{
   "name": "asm_project_generator",
   "version": "2.7.2",
   "versionDate": "2026-08-09",
   "description": "ASM Project Generator Electron wrapper",
   "main": "main.js",
   "scripts": {
      "start": "electron .",
      "build:ui-assets": "tailwindcss -i assets/styles/tailwind-input.css -o assets/styles/tailwind.css --minify",
      "dist:installer": "electron-builder --win nsis --x64",
      "test": "echo \"Error: no test specified\" && exit 1"
   },
   "keywords": [],
   "author": "Новожилов Артем",
   "license": "ISC",
   "type": "commonjs",
   "repository": {
      "type": "git",
      "url": "https://github.com/revi96or/ASM-Project-Generator.git"
   },
   "build": {
      "appId": "ru.asm.projectgenerator",
      "productName": "ASM Project Generator",
      "asar": true,
      "icon": "assets\\asm-icon.ico",
      "publish": [
         {
            "provider": "github",
            "owner": "revi96or",
            "repo": "ASM-Project-Generator"
         }
      ],
      "files": [
         "**/*",
         "!dist/**",
         "!release-backups/**",
         "!templates/**",
         "!.git/**",
         "!*.log",
         "!*.txt"
      ],
      "extraResources": [
         {
            "from": "templates",
            "to": "templates"
         }
      ],
      "win": {
         "icon": "assets\\asm-icon.ico",
         "target": [
            "nsis"
         ]
      },
      "nsis": {
         "artifactName": "ASM_Project_Generator-${version}-setup.exe",
         "oneClick": false,
         "allowToChangeInstallationDirectory": true
      }
   },
   "dependencies": {
      "electron-updater": "^6.5.0"
   },
   "devDependencies": {
      "@fontsource/inter": "^5.1.1",
      "@fontsource/jetbrains-mono": "^5.1.1",
      "electron": "^43.2.0",
      "electron-builder": "^26.15.3",
      "lucide": "^0.468.0",
      "tailwindcss": "^3.4.17"
   }
}
